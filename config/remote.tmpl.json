{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-google",
        "type": "https",
        "server": "8.8.8.8",
        "tls": {
          "enabled": true,
          "server_name": "dns.google"
        }
      }
    ],
    "rules": [
      {
        "query_type": [
          "AAAA"
        ],
        "action": "reject"
      }
    ],
    "final": "dns-google"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "::",
      "listen_port": 443,
      "users": [
        {
          "uuid": "{UUID}",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.apple.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.apple.com",

            "server_port": 443
          },
          "private_key": "{PRIVATE_KEY}",
          "short_id": [
            "{SHORT_ID}"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "portal-out",
      "server": "{PROXY_IP}",
      "server_port": "{PROXY_PORT}",
      "connect_timeout": "8s",
      "tcp_keep_alive": "30s",
      "tcp_keep_alive_interval": "30s",
      "username": "{PROXY_USERNAME}",
      "password": "{PROXY_PASSWORD}"
    },
    {
      "type": "direct",
      "tag": "do-out"
    },
    {
      "type": "block",
      "tag": "block-out"
    }
  ],
  "route": {
    "default_domain_resolver": "dns-google",
    "rule_set": [
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-youtube.srs",
        "update_interval": "24h",
        "download_detour": "do-out"
      },
      {
        "tag": "geosite-ads",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs",
        "update_interval": "24h",
        "download_detour": "do-out"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "rule_set": [
          "geosite-ads"
        ],
        "action": "reject"
      },
      {
        "domain_suffix": [
          "github.com",
          "githubusercontent.com"
        ],
        "outbound": "do-out"
      },
      {
        "rule_set": [
          "geosite-youtube"
        ],
        "outbound": "do-out"
      }
    ],
    "final": "portal-out"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db"
    }
  }
}
